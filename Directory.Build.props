<Project>
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <UseSharedCompilation>false</UseSharedCompilation>
    <RestoreSources>https://api.nuget.org/v3/index.json</RestoreSources>
    <Version>1.0.2</Version>
    <Authors>eugeny-dementev</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/eugeny-dementev/avalon-four-rings</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <Target Name="RequireGameDirectory" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameRoot)/Fall of Avalon_Data/Managed/TG.Main.dll')" Text="Set GameRoot to a local Mono game installation. Use scripts/build.ps1 -GameDirectory." />
  </Target>
</Project>
